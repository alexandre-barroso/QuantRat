ClearAll["Global`*"];
must[condition_, label_] := If[!TrueQ[condition], Print["FAIL: " <> label]; Exit[1]];
checks = <||>;
checks["threshold_bounds"] = FullSimplify[1/4 < (q - 2 t + 1)/(2 q) < 1/2, Assumptions -> Element[{q, t}, Reals] && t >= 1 && q > 4 t];
checks["positive_remainder"] = FullSimplify[0 < t - (n - 1) p <= p, Assumptions -> Element[{t, n, p}, Reals] && p > 0 && (n - 1) p < t <= n p];
checks["profile_progression"] = FullSimplify[z + j c + w/d - Floor[z + j c + w/d] == w/d, Assumptions -> Element[{z, j, c, w, d}, Integers] && d > 0 && 0 <= w < d];
checks["constructed_prefix_cost_identity"] = FullSimplify[j (1 - 2 ((1 - l (2 t - 1))/2)) + l ((t - j)^2 - t^2) == l j (j - 1), Assumptions -> Element[{l, t, j}, Reals]];
checks["marginal_gap"] = FullSimplify[1 - 2 f + l ((t - j)^2 - (t - j + 1)^2) >= 2 l (j - 1), Assumptions -> Element[{f, l, t, j}, Reals] && l > 0 && f <= (1 - l (2 t - 1))/2];
checks["perturbation_gap"] = FullSimplify[2 l - e t^2 > l, Assumptions -> Element[{l, e, t}, Reals] && l > 0 && t >= 1 && 0 < e < l/t^2];
checks["positive_curvature"] = FullSimplify[2 l - e > l, Assumptions -> Element[{l, e, t}, Reals] && l > 0 && t >= 1 && 0 < e < l/t^2];
checks["nearby_bump_intervals"] = FullSimplify[(x^2 + y^2)/(16 t^2) < x y/t^2, Assumptions -> Element[{x, y, t}, Reals] && 0 < x < y < 2 x && t >= 1];
checks["distant_bump_intervals"] = FullSimplify[(x^2 + y^2)/(16 t^2) < y - x, Assumptions -> Element[{x, y, t}, Reals] && 0 < x && 2 x <= y <= 1 && t >= 1];
targets = {{31, 4, 1}/36, {7, 1, 1, 1, 1, 1}/12, ConstantArray[1/6, 6]};
profiles = {{4, 4, 1}/9, ConstantArray[1/3, 6], ConstantArray[1/3, 6]};
meshes = {4 (1 + 9 j), 4 (4 + 3 j), 4 (2 + 3 j)};
checks["compact_progressions"] = And @@ Table[FullSimplify[FractionalPart[meshes[[i]] targets[[i]]] == profiles[[i]], Assumptions -> Element[j, Integers] && j >= 0], {i, 3}];
costs = Table[With[{f = profiles[[i]], t = Total[profiles[[i]]]}, Table[Total[f^2] + Total[Take[1 - 2 f, k]] + (t - k)^2/9, {k, 0, t}]], {i, 3}];
checks["compact_costs"] = costs == {{14/27, 14/27}, {10/9, 10/9, 4/3}, {10/9, 10/9, 4/3}};
checks["finite_reciprocal_orientation"] = FullSimplify[1/(2/m) < 1/(1/m), Assumptions -> Element[m, Reals] && m > 0];
checks["quotient_first_derivative"] = FullSimplify[D[chi[s]/s, s] == chi'[s]/s - chi[s]/s^2, Assumptions -> Element[s, Reals] && s != 0];
checks["quotient_second_derivative"] = FullSimplify[D[chi[s]/s, {s, 2}] == chi''[s]/s - 2 chi'[s]/s^2 + 2 chi[s]/s^3, Assumptions -> Element[s, Reals] && s != 0];
checks["reciprocal_plateau_derivatives"] = FullSimplify[{1/s, D[1/s, s], D[1/s, {s, 2}]} == {1/s, -1/s^2, 2/s^3}, Assumptions -> Element[s, Reals] && s > 0];
cutoffScale = Min[eta, 1/36]/(2 (1 + bound));
checks["positive_small_quotient_scale"] = FullSimplify[cutoffScale > 0 && cutoffScale bound < eta && cutoffScale bound < 1/36, Assumptions -> Element[{eta, bound}, Reals] && eta > 0 && bound >= 0];
checks["scaled_quotient_observations"] = FullSimplify[0 < alpha/s && alpha/(2/s) < alpha/(1/s), Assumptions -> Element[{alpha, s}, Reals] && alpha > 0 && s > 0];
step = 1/(1 + Exp[1/z - 1/(1 - z)]);
endpointJets = Table[{Limit[D[step, {z, k}], z -> 0, Direction -> "FromAbove"], Limit[D[step, {z, k}], z -> 1, Direction -> "FromBelow"]}, {k, 0, 2}];
checks["smooth_step_endpoint_jets_through_two"] = endpointJets == {{0, 1}, {0, 0}, {0, 0}};
checks["step_derivative_envelope_constants"] = FullSimplify[4/Exp[2] < 1 && 256/Exp[4] + 54/Exp[3] < 8 && Exp[2] + 2 Exp[4] < 200 && 8 Exp[2] + 20 Exp[4] + 8 Exp[6] < 8000];
checks["cutoff_transition_affine_plateaus"] = FullSimplify[((s - delta/3) 3/(2 delta) <= 0) == (s <= delta/3) && ((s - delta/3) 3/(2 delta) >= 1) == (s >= delta), Assumptions -> Element[{s, delta}, Reals] && delta > 0];
checks["displayed_target_padding"] = {({4, 4, 1} + {4*9 - 9, 0, 0})/(4*9), (ConstantArray[1, 6] + {4*3 - 6, 0, 0, 0, 0, 0})/(4*3), ConstantArray[2, 6]/(4*3)} == targets;
checks["displayed_minimum_heights"] = Ceiling[{Total[{4, 4, 1}]/9, Total[ConstantArray[1, 6]]/3, Total[ConstantArray[2, 6]]/3}] == {1, 2, 4};
KeyValueMap[must[#2, #1] &, checks];
result = <|"status" -> "PASS_SCOPED_SYMBOLIC_CHECKS", "WolframVersion" -> $Version, "checks" -> checks, "normalized_compact_costs" -> Map[ToString[#, InputForm] &, costs, {2}], "scope" -> "Explicit-domain symbolic identities, inequalities, cutoff endpoint derivatives through order two and quotient/scaling checks. These finite symbolic checks do not prove infinite-order flatness or all-minimizer equivalence; Lean supplies those quantified results. No novelty claim is machine-certified."|>;
If[Length[$ScriptCommandLine] >= 2, output = ExpandFileName[Last[$ScriptCommandLine]]; repository = DirectoryName[ExpandFileName[$InputFileName]]; must[!StringStartsQ[output, repository <> $PathnameSeparator], "output outside repository"]; Export[output, result, "RawJSON"]];
Print[ExportString[result, "RawJSON"]];
Exit[0];
